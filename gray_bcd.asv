%
k = 4
simbolo_BCD = gray_a_bcd([1,0,1,1], k)

function simbolo_BCD = gray_a_bcd(simbolo_gray, k)
    bit_actual = simbolo_gray(1);
    simbolo_BCD = 0;
    indice = 2;
    while (indice < k-1)
        bit_siguiente = simbolo_gray(indice);
        simbolo_BCD(k-indice) = bitxor(bit_actual, bit_siguiente)
        bit_actual = bit_siguiente;
        indice = indice + 1;
    end    
end